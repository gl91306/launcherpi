{
  "name": "launcherpi",
  "version": "1.2.1",
  "description": "A minecraft java launcher",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build-app.js"
  },
  "keywords": [
    "mc",
    "mineraft",
    "mc-launcher",
    "mc-java"
  ],
  "author": {
    "name": "gl91306 and oxmc",
    "email": "contact@oxmc.is-a.dev"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "axios": "^1.6.8",
    "child_process": "^1.0.2",
    "electron-window-state": "^5.0.3",
    "onezip": "^6.0.2",
    "request": "^2.88.2",
    "unzipper": "^0.10.14",
    "v8-compile-cache": "^2.4.0"
  },
  "build": {
    "appId": "com.glox.launcherpi",
    "productName": "LauncherPi",
    "asarUnpack": [],
    "artifactName": "launcherpi-${version}-${platform}-${arch}.${ext}",
    "mac": {
      "icon": "renderer/images/icon.icns",
      "category": "Admin"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "renderer/images/icon_256.png",
      "category": "Admin"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/images/icon.ico"
    }
  }
}
